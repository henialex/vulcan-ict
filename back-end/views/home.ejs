        <script>
            // AI Robot Cursor Follower
            (function() {
                const robot = document.getElementById('ai_robot');
                const robotContainer = document.querySelector('.ai_robot_container');
                
                if (!robot || !robotContainer) return;
                
                let mouseX = 0;
                let mouseY = 0;
                let targetX = 0;
                let targetY = 0;
                let currentX = 0;
                let currentY = 0;
                
                // Initialize robot at center
                function initRobot() {
                    const rect = robotContainer.getBoundingClientRect();
                    targetX = rect.width / 2;
                    targetY = rect.height / 2;
                    currentX = targetX;
                    currentY = targetY;
                }
                
                initRobot();
                
                // Update mouse position relative to container
                robotContainer.addEventListener('mousemove', function(e) {
                    const rect = robotContainer.getBoundingClientRect();
                    mouseX = e.clientX - rect.left;
                    mouseY = e.clientY - rect.top;
                    targetX = mouseX;
                    targetY = mouseY;
                });
                
                // Reset to center when mouse leaves
                robotContainer.addEventListener('mouseleave', function() {
                    const rect = robotContainer.getBoundingClientRect();
                    targetX = rect.width / 2;
                    targetY = rect.height / 2;
                });
                
                // Smooth animation loop
                function animate() {
                    // Smooth interpolation
                    const ease = 0.15;
                    currentX += (targetX - currentX) * ease;
                    currentY += (targetY - currentY) * ease;
                    
                    // Calculate rotation angle
                    const dx = targetX - currentX;
                    const dy = targetY - currentY;
                    const angle = Math.atan2(dy, dx) * (180 / Math.PI);
                    
                    // Apply transform (centered on robot - 300px x 300px)
                    robot.style.transform = `translate(${currentX - 150}px, ${currentY - 150}px) rotate(${angle}deg)`;
                    
                    requestAnimationFrame(animate);
                }
                
                // Update on resize
                window.addEventListener('resize', initRobot);
                
                // Start animation
                animate();
            })();
        </script>
