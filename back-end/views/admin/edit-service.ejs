<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Edit Service: <%= service.title %> | Vulcan ICT CMS</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "on-tertiary-fixed": "#2c1700",
            "outline": "#6d7980",
            "surface-dim": "#d9dadb",
            "on-primary-fixed": "#001e2c",
            "surface-container-high": "#e7e8e9",
            "surface-container-lowest": "#ffffff",
            "tertiary-fixed": "#ffdcbc",
            "tertiary-container": "#f59a24",
            "inverse-surface": "#2e3132",
            "secondary-fixed-dim": "#a0cce7",
            "inverse-on-surface": "#f0f1f2",
            "surface-container": "#edeeef",
            "inverse-primary": "#78d1ff",
            "surface-container-highest": "#e1e3e4",
            "primary-container": "#06bcf9",
            "background": "#f8f9fa",
            "error": "#ba1a1a",
            "on-secondary-fixed-variant": "#1c4c62",
            "on-secondary-container": "#3a667d",
            "primary-fixed": "#c2e8ff",
            "on-surface": "#191c1d",
            "on-secondary": "#ffffff",
            "on-primary-fixed-variant": "#004d68",
            "on-primary": "#ffffff",
            "outline-variant": "#bcc8d1",
            "surface-bright": "#f8f9fa",
            "surface": "#f8f9fa",
            "error-container": "#ffdad6",
            "secondary": "#37637b",
            "primary": "#006689",
            "tertiary-fixed-dim": "#ffb86c",
            "on-background": "#191c1d",
            "on-surface-variant": "#3d484f",
            "surface-variant": "#e1e3e4",
            "surface-container-low": "#f3f4f5",
            "on-primary-container": "#004862",
            "on-error": "#ffffff",
            "on-secondary-fixed": "#001e2c",
            "primary-fixed-dim": "#78d1ff",
            "secondary-container": "#b6e3fe",
            "on-tertiary-fixed-variant": "#683c00",
            "surface-tint": "#006689",
            "on-tertiary-container": "#623800",
            "on-error-container": "#93000a",
            "secondary-fixed": "#c2e8ff",
            "tertiary": "#895100",
            "on-tertiary": "#ffffff"
          },
          "borderRadius": {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          "fontFamily": {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          }
        }
      }
    }
  </script>

  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .brand-font { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .gradient-button { background: linear-gradient(135deg, #006689 0%, #06bcf9 100%); }
  </style>
</head>

<body class="bg-background text-on-surface">
  <!-- SideNavBar Component -->
  <aside class="h-screen w-64 fixed left-0 top-0 overflow-y-auto bg-slate-100 dark:bg-slate-900 flex flex-col py-6 px-4 font-manrope text-sm font-medium z-50">
    <div class="mb-8 px-2">
      <h1 class="text-2xl font-bold tracking-tighter text-slate-900 dark:text-white">Vulcan ICT</h1>
      <p class="text-xs text-slate-500">Admin Dashboard</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 rounded-xl" href="/admin">
        <span class="material-symbols-outlined">dashboard</span>
        Dashboard
      </a>

      <a class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 rounded-xl" href="/admin/projects">
        <span class="material-symbols-outlined">folder_special</span>
        Projects
      </a>

      <a class="flex items-center gap-3 px-3 py-2 text-cyan-600 dark:text-cyan-400 font-semibold bg-slate-200/50 dark:bg-slate-800 rounded-xl" href="/admin/services">
        <span class="material-symbols-outlined">engineering</span>
        Services
      </a>

      <a class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 rounded-xl" href="/admin/messages">
        <span class="material-symbols-outlined">mail</span>
        Messages
      </a>
    </nav>

    <div class="mt-auto pt-6 border-t border-slate-200 dark:border-slate-800 space-y-1">
      <a class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 rounded-xl" href="/admin/logout">
        <span class="material-symbols-outlined">logout</span>
        Logout
      </a>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="ml-64 pt-16 min-h-screen">
    <!-- TopAppBar Component -->
    <header class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 z-40 bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl border-b border-slate-200/50 dark:border-slate-800/50 flex justify-between items-center px-8">
      <div class="flex items-center gap-4">
        <div class="relative group">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 material-symbols-outlined text-sm">search</span>
          <input class="pl-10 pr-4 py-1.5 bg-surface-container-low border-none rounded-full text-sm focus:ring-2 focus:ring-primary-container w-64 transition-all" placeholder="Search resources..." type="text"/>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex items-center gap-4 text-slate-600">
          <button class="hover:text-cyan-500 transition-all" type="button">
            <span class="material-symbols-outlined">notifications</span>
          </button>
          <button class="hover:text-cyan-500 transition-all" type="button">
            <span class="material-symbols-outlined">help_outline</span>
          </button>
        </div>

        <div class="h-8 w-px bg-slate-200"></div>

        <div class="flex items-center gap-3">
          <img class="w-8 h-8 rounded-full object-cover" alt="Admin avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDnzop_QanmHrCOCQiaxGJfz7NQXzXPRbM5VgZ6GBqkdD2hZE4Rvyxkb7bizJffwmh7QhGzhuC1yGL_JFk-YI9KSDeo3gZzvSerEEEIu3_QOK6CrjvdNtIli5oIabRdY-bMZmg4S-G3mTZBoMKca73exhBF3Y0ReIG9WwDD7F3xCb86zecO7-V5SNj7siSX-v77EBkroHhDBYGD9prDCtLiQE0OxR-qVj0P7S_xAcldrDAk0EIcw4jLgk33iQwfQOnBlOuy6vTAABt9"/>
          <div class="hidden lg:block text-right">
            <p class="text-xs font-bold text-on-surface">Vulcan ICT Admin</p>
            <p class="text-[10px] text-slate-500">Super Admin</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Form Content Container -->
    <div class="max-w-6xl mx-auto p-8">
      <% if (success) { %>
        <div class="mb-8 rounded-xl border border-green-200 bg-green-50 px-5 py-4 text-sm font-medium text-green-700">
          Service updated successfully!
        </div>
      <% } %>

      <form action="/admin/edit-service/<%= service.id %>" method="POST">
        <!-- Breadcrumbs & Header -->
        <div class="mb-8">
          <nav class="flex items-center gap-2 text-xs text-slate-500 mb-2">
            <a class="hover:text-primary" href="/admin/services">Services</a>
            <span class="material-symbols-outlined text-[10px]">chevron_right</span>
            <span class="text-on-surface font-medium"><%= service.title %></span>
          </nav>

          <div class="flex justify-between items-end">
            <div>
              <h2 class="text-3xl font-extrabold tracking-tight text-on-surface mb-1">Edit Service</h2>
              <p class="text-on-surface-variant">Update the technical specifications and delivery details for this service.</p>
            </div>

            <div class="flex gap-3">
              <a href="/admin/services" class="px-6 py-2.5 text-sm font-semibold text-primary hover:bg-primary/5 transition-colors rounded-xl">
                Discard Changes
              </a>
              <button type="submit" class="gradient-button px-8 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/20 rounded-xl transition-transform active:scale-95">
                Update Service
              </button>
            </div>
          </div>
        </div>

        <!-- Editor Grid -->
        <div class="grid grid-cols-12 gap-8">
          <!-- Left Column: Core Settings -->
          <div class="col-span-12 lg:col-span-8 space-y-8">
            <!-- Section: General Information -->
            <section class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/10">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined">info</span>
                </div>
                <h3 class="text-lg font-bold tracking-tight">General Information</h3>
              </div>

              <div class="space-y-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Service Name</label>
                  <input
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    type="text"
                    name="title"
                    value="<%= service.title %>"
                    required
                  />
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Category</label>
                    <input
                      class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                      type="text"
                      name="category"
                      value="<%= service.category || '' %>"
                    />
                  </div>

                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Service ID</label>
                    <input
                      class="w-full bg-surface-container-high border-none rounded-xl px-4 py-3 text-slate-500 cursor-not-allowed"
                      readonly
                      type="text"
                      value="SRV-<%= service.id %>"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Detailed Description</label>
                  <textarea
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    rows="5"
                    name="description"
                    required
                  ><%= service.description %></textarea>
                </div>
              </div>
            </section>

            <!-- Section: Service Content -->
            <section class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/10">
              <div class="flex justify-between items-center mb-6">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-tertiary-container/10 flex items-center justify-center text-tertiary-container">
                    <span class="material-symbols-outlined">edit_note</span>
                  </div>
                  <h3 class="text-lg font-bold tracking-tight">Service Content</h3>
                </div>
              </div>

              <div class="space-y-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">The Problem</label>
                  <textarea
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    rows="3"
                    name="problem"
                  ><%= service.problem || '' %></textarea>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Target Audience</label>
                  <textarea
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    rows="3"
                    name="target_audience"
                  ><%= service.target_audience || '' %></textarea>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Why Trust Us?</label>
                  <input
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    type="text"
                    name="trust_reason"
                    value="<%= service.trust_reason || '' %>"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Features</label>
                  <textarea
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    rows="4"
                    name="features"
                  ><%= service.features || '' %></textarea>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Icon Class</label>
                  <input
                    class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 text-on-surface focus:ring-2 focus:ring-primary-container transition-all"
                    type="text"
                    name="icon_class"
                    value="<%= service.icon_class || '' %>"
                  />
                </div>
              </div>
            </section>
          </div>

          <!-- Right Column: Sidebar Options -->
          <div class="col-span-12 lg:col-span-4 space-y-8">
            <!-- Section: Media & Visuals -->
            <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10">
              <h3 class="text-md font-bold mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">image</span>
                Service Visuals
              </h3>

              <div class="relative group aspect-video rounded-xl overflow-hidden mb-4 bg-surface-container-high cursor-pointer">
                <img class="w-full h-full object-cover" alt="Service visual placeholder" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuHvZAUXP3PMPE9HfM8-rGRO534YCZcO45qi4ky7XY4dM4nn3meNfP7Jx6IB79RU4-RZhKD8sD_EwtSJDgLPfLzDBJscYJHeJh03TsXacNZKSq3dPlRup6-ECs_rko-Qe8foosr4EktF_MyW8Ulni742MeYrGw-u1v5Ic43cmNbrf3PF8qP-vtZW-6iNPRMj2JqXPjdYJNotQm3mNNxeYrZeMABCG3AV1b6hbVR47oIlD8EuoRP8l7pWaHpJ88Btf6fRy0gjI9Ajja"/>
                <div class="absolute inset-0 bg-on-surface/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="bg-white px-4 py-2 rounded-full text-xs font-bold text-on-surface" type="button">Visual Placeholder</button>
                </div>
              </div>

              <p class="text-[10px] text-slate-400 text-center italic">Supported formats: JPG, PNG (Max 5MB)</p>
            </section>

            <!-- Section: Metadata & Tags -->
            <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10">
              <h3 class="text-md font-bold mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">label</span>
                Attributes
              </h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-[10px] font-bold text-slate-500 mb-2 uppercase">Service Tags</label>
                  <input
                    class="w-full bg-surface-container-low border-none rounded-lg text-sm px-3 py-2"
                    placeholder="Tags placeholder"
                    type="text"
                    value="<%= service.category || '' %>"
                    readonly
                  />
                </div>

                <hr class="border-outline-variant/20"/>

                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold text-on-surface">Publish Status</p>
                    <p class="text-[10px] text-slate-500">Visible to clients</p>
                  </div>
                  <div class="relative inline-flex items-center cursor-pointer">
                    <input checked class="sr-only peer" type="checkbox"/>
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container"></div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Section: Team Access -->
            <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10">
              <h3 class="text-md font-bold mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">groups</span>
                Technical Lead
              </h3>

              <div class="flex items-center gap-3 p-3 bg-surface-container-low rounded-xl">
                <img class="w-10 h-10 rounded-full object-cover" alt="Lead avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDbUumbX4FMw7otQ1xpbbN0WOpj0qZ7iHQIgxQaceqf4p7LfnFDuVNWxDdSWplOg-3M55dWvBFWygMYBsKKp_uiMTS76L7oY7ibv4m1XplrzkB81NMDBBhpMx3sbXBS_hCeD6eYYyY2byE2hqR9sDkTTqsFWggWEIwaBVSWdonrqXuDM684lvuPi19iunvJZHVxNHNo8u1Ifr01Jm2NjL7f1V4GLRUGkskxrupCRTw0a9Wllp9mUYm6lHb0hEa-VwIf0UQ8drHVG_ro"/>
                <div>
                  <p class="text-xs font-bold text-on-surface">Marcus Thorne</p>
                  <p class="text-[10px] text-slate-500">Lead Architect</p>
                </div>
                <button class="ml-auto text-slate-400 hover:text-primary" type="button">
                  <span class="material-symbols-outlined text-sm">swap_horiz</span>
                </button>
              </div>
            </section>
          </div>
        </div>

        <!-- Danger Zone -->
        <div class="mt-12 p-8 bg-error-container/20 rounded-xl border border-error/10">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="text-error font-bold text-lg mb-1">Danger Zone</h4>
              <p class="text-sm text-on-error-container/70">Deleting this service will remove it from the public website listing.</p>
            </div>

            <a href="/admin/delete-service/<%= service.id %>" onclick="return confirm('Are you sure?')" class="px-6 py-2.5 bg-error text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-colors">
              Archive Service
            </a>
          </div>
        </div>
      </form>
    </div>
  </main>
</body>
</html>