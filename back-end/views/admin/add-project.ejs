<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Add Project | Vulcan ICT CMS</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "on-tertiary-fixed": "#2c1700",
            "outline": "#6d7980",
            "surface-dim": "#d9dadb",
            "on-primary-fixed": "#001e2c",
            "surface-container-high": "#e7e8e9",
            "surface-container-lowest": "#ffffff",
            "tertiary-fixed": "#ffdcbc",
            "tertiary-container": "#f59a24",
            "inverse-surface": "#2e3132",
            "secondary-fixed-dim": "#a0cce7",
            "inverse-on-surface": "#f0f1f2",
            "surface-container": "#edeeef",
            "inverse-primary": "#78d1ff",
            "surface-container-highest": "#e1e3e4",
            "primary-container": "#06bcf9",
            "background": "#f8f9fa",
            "error": "#ba1a1a",
            "on-secondary-fixed-variant": "#1c4c62",
            "on-secondary-container": "#3a667d",
            "primary-fixed": "#c2e8ff",
            "on-surface": "#191c1d",
            "on-secondary": "#ffffff",
            "on-primary-fixed-variant": "#004d68",
            "on-primary": "#ffffff",
            "outline-variant": "#bcc8d1",
            "surface-bright": "#f8f9fa",
            "surface": "#f8f9fa",
            "error-container": "#ffdad6",
            "secondary": "#37637b",
            "primary": "#006689",
            "tertiary-fixed-dim": "#ffb86c",
            "on-background": "#191c1d",
            "on-surface-variant": "#3d484f",
            "surface-variant": "#e1e3e4",
            "surface-container-low": "#f3f4f5",
            "on-primary-container": "#004862",
            "on-error": "#ffffff",
            "on-secondary-fixed": "#001e2c",
            "primary-fixed-dim": "#78d1ff",
            "secondary-container": "#b6e3fe",
            "on-tertiary-fixed-variant": "#683c00",
            "surface-tint": "#006689",
            "on-tertiary-container": "#623800",
            "on-error-container": "#93000a",
            "secondary-fixed": "#c2e8ff",
            "tertiary": "#895100",
            "on-tertiary": "#ffffff"
          },
          "borderRadius": {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          "fontFamily": {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          }
        }
      }
    }
  </script>

  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .brand-font { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="bg-background text-on-surface">
  <!-- SideNavBar -->
  <aside class="h-screen w-64 fixed left-0 top-0 overflow-y-auto bg-slate-100 dark:bg-slate-900 border-none flex flex-col h-full py-6 px-4 z-40">
    <div class="mb-10 px-2">
      <h1 class="text-2xl font-bold tracking-tighter text-slate-900 dark:text-white">Vulcan ICT</h1>
      <p class="font-manrope text-sm font-medium text-slate-500">Admin Dashboard</p>
    </div>

    <nav class="flex-1 space-y-1">
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-manrope text-sm font-medium text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 scale-95 active:scale-90 transition-transform" href="/admin">
        <span class="material-symbols-outlined">dashboard</span>
        Dashboard
      </a>

      <a class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-manrope text-sm font-medium text-cyan-600 dark:text-cyan-400 font-semibold bg-slate-200/50 dark:bg-slate-800/50 scale-95 active:scale-90 transition-transform" href="/admin/projects">
        <span class="material-symbols-outlined">folder_special</span>
        Projects
      </a>

      <a class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-manrope text-sm font-medium text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 scale-95 active:scale-90 transition-transform" href="/admin/services">
        <span class="material-symbols-outlined">engineering</span>
        Services
      </a>

      <a class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-manrope text-sm font-medium text-slate-500 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors duration-200 scale-95 active:scale-90 transition-transform" href="/admin/messages">
        <span class="material-symbols-outlined">mail</span>
        Messages
      </a>
    </nav>

   <div class="pt-6 mt-6 border-t border-slate-200 space-y-1">
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-500 hover:bg-slate-200 transition-colors duration-200" href="/admin/logout">
        <span class="material-symbols-outlined">logout</span>
        <span class="text-sm font-medium">Logout</span>
      </a>
    </div>

    <div class="mt-8 flex items-center gap-3 px-2">
      <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-white text-sm font-bold">
        A
      </div>
      <div>
        <p class="text-xs font-bold text-slate-900">Admin User</p>
        <p class="text-[10px] text-slate-500">Vulcan ICT Admin</p>
      </div>
  </aside>

  <!-- TopAppBar -->
  <header class="fixed top-0 right-0 w-[calc(100%-16rem)] h-16 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl border-b border-slate-200/50 dark:border-slate-800/50 flex justify-between items-center px-8">
    <div class="flex items-center gap-4 flex-1">
      <div class="relative w-full max-w-md">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
        <input class="w-full bg-surface-container-low border-none rounded-full py-1.5 pl-10 pr-4 text-sm focus:ring-2 focus:ring-primary-container transition-all" placeholder="Search systems..." type="text"/>
      </div>
    </div>

    <div class="flex items-center gap-6">
      <div class="flex items-center gap-3">
        <button class="p-2 text-slate-600 hover:text-cyan-500 transition-all" type="button">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="p-2 text-slate-600 hover:text-cyan-500 transition-all" type="button">
          <span class="material-symbols-outlined">help_outline</span>
        </button>
      </div>

      <div class="h-6 w-px bg-slate-200"></div>

      <button class="text-sm font-medium text-slate-600 hover:text-cyan-500 transition-all" type="button">Support</button>

      <a href="/admin/add-project" class="bg-gradient-to-br from-primary to-primary-container text-white px-5 py-2 rounded-xl text-sm font-semibold shadow-lg shadow-cyan-500/20 hover:scale-105 active:scale-95 transition-all">
        New Project
      </a>

      <div class="w-8 h-8 rounded-full bg-slate-200 overflow-hidden">
        <img class="w-full h-full object-cover" alt="Admin avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCGyx94jsSMRVR4FR6zozxXahDSUQPnrkFZcjybjnaTQQuahcO6qMZMXoqqzQisncO_pmUqfhIwVsjU94BIG_Wo32G-YYZ1T3rz5eicKhUi6cHlWAxWuqaqKWXliZpv_5rgTokp_T3-4B5As5FrxQQYqUtUYdojwb2ixSJT9l1GvxarDH9Tv2ECD9poqclJNLqL0VEapWvMuEIohQOJiDnqbbvEJ8qyIOGhokw6-VJtIrlXAIpE79lH-Q1lvFUzbg3nOfydktPOtaIM"/>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="ml-64 pt-24 pb-12 px-12 max-w-6xl">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 mb-8 text-sm font-medium">
      <a class="text-on-surface-variant hover:text-primary transition-colors" href="/admin">Dashboard</a>
      <span class="material-symbols-outlined text-outline-variant text-xs">chevron_right</span>
      <a class="text-on-surface-variant hover:text-primary transition-colors" href="/admin/projects">Projects</a>
      <span class="material-symbols-outlined text-outline-variant text-xs">chevron_right</span>
      <span class="text-on-surface">Add New Project</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-10">
      <h2 class="text-4xl font-extrabold tracking-tight text-on-surface mb-2">Create New Project</h2>
      <p class="text-on-surface-variant text-lg">Define parameters for the next ICT architecture deployment.</p>
    </header>

    <% if (success) { %>
      <div class="mb-8 rounded-xl border border-green-200 bg-green-50 px-5 py-4 text-sm font-medium text-green-700">
        Project added successfully!
      </div>
    <% } %>

    <form action="/admin/add-project" method="POST" enctype="multipart/form-data">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Form Card -->
        <div class="lg:col-span-2 space-y-8">
          <section class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/15 transition-all hover:-translate-y-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- Title Field -->
              <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-on-surface-variant mb-2">Project Title</label>
                <input
                  class="w-full bg-surface-container-low border-none rounded-xl p-4 text-base focus:bg-surface-container-lowest focus:ring-0 border-b-2 border-transparent focus:border-primary transition-all"
                  placeholder="e.g. Enterprise Cloud Migration Phase II"
                  type="text"
                  name="title"
                  required
                />
              </div>

              <!-- Client Field -->
              <div>
                <label class="block text-sm font-semibold text-on-surface-variant mb-2">Client Name</label>
                <div class="relative">
                  <input
                    class="w-full bg-surface-container-low border-none rounded-xl p-4 pl-12 text-base focus:bg-surface-container-lowest focus:ring-0 border-b-2 border-transparent focus:border-primary transition-all"
                    placeholder="Select or type client"
                    type="text"
                    name="client"
                  />
                  <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">business</span>
                </div>
              </div>

              <!-- Category Field -->
              <div>
                <label class="block text-sm font-semibold text-on-surface-variant mb-2">Category</label>
                <div class="relative">
                  <input
                    class="w-full bg-surface-container-low border-none rounded-xl p-4 pr-10 text-base focus:bg-surface-container-lowest focus:ring-0 border-b-2 border-transparent focus:border-primary transition-all"
                    type="text"
                    name="category"
                    placeholder="e.g. Cloud Infrastructure"
                  />
                  <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                </div>
              </div>

              <!-- Description Field -->
              <div class="md:col-span-2">
                <label class="block text-sm font-semibold text-on-surface-variant mb-2">Project Description</label>
                <textarea
                  class="w-full bg-surface-container-low border-none rounded-xl p-4 text-base focus:bg-surface-container-lowest focus:ring-0 border-b-2 border-transparent focus:border-primary transition-all resize-none"
                  placeholder="Provide a detailed technical overview and objectives..."
                  rows="6"
                  name="description"
                  required
                ></textarea>
              </div>
            </div>
          </section>
        </div>

        <!-- Sidebar Form Elements -->
        <div class="lg:col-span-1 space-y-8">
          <!-- Image Upload Area -->
          <section class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/15 transition-all hover:-translate-y-1">
            <label class="block text-sm font-semibold text-on-surface-variant mb-4">Project Cover Image</label>

            <label for="image" class="aspect-square w-full rounded-xl bg-surface-container-low border-2 border-dashed border-outline-variant flex flex-col items-center justify-center p-6 text-center group cursor-pointer hover:bg-surface-container transition-colors">
              <div class="w-16 h-16 rounded-full bg-primary-fixed-dim flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl">add_photo_alternate</span>
              </div>
              <p class="text-sm font-semibold text-on-surface mb-1">Click to upload</p>
              <p class="text-xs text-on-surface-variant">PNG, JPG or WEBP (Max. 5MB)</p>
            </label>

            <input
              class="hidden"
              type="file"
              id="image"
              name="image"
              accept=".png,.jpg,.jpeg,.webp"
              required
              onchange="showSelectedFile(event)"
            />

            <div id="selectedFileBox" class="mt-4 hidden items-center gap-3 p-3 bg-surface-container-low rounded-lg">
              <div class="w-10 h-10 rounded bg-surface-container-highest overflow-hidden flex items-center justify-center">
                <span class="material-symbols-outlined text-base text-outline">image</span>
              </div>
              <div class="flex-1 overflow-hidden">
                <p id="selectedFileName" class="text-xs font-bold truncate">No file selected</p>
                <p class="text-[10px] text-outline">Ready for upload</p>
              </div>
              <button class="text-error hover:scale-110 transition-transform" type="button" onclick="clearSelectedFile()">
                <span class="material-symbols-outlined text-base">delete</span>
              </button>
            </div>
          </section>

          <!-- Action Buttons Card -->
          <section class="bg-primary/5 p-8 rounded-xl border border-primary/10 flex flex-col gap-4">
            <h3 class="text-sm font-bold text-primary uppercase tracking-wider">Finalize</h3>

            <button class="w-full bg-gradient-to-br from-primary to-primary-container text-white py-4 rounded-xl font-bold shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2" type="submit">
              <span class="material-symbols-outlined">save</span>
              Save Project
            </button>

            <a href="/admin/projects" class="w-full bg-white text-on-surface py-4 rounded-xl font-bold border border-outline-variant/30 hover:bg-surface-container-low transition-all flex items-center justify-center gap-2 text-center">
              Cancel
            </a>

            <div class="mt-2 flex items-center gap-2 px-2 text-[10px] text-on-surface-variant italic">
              <span class="material-symbols-outlined text-xs">info</span>
              Changes are saved as a draft by default.
            </div>
          </section>
        </div>
      </div>
    </form>

    <!-- Decorative Background Element -->
    <div class="fixed -bottom-24 -right-24 w-96 h-96 bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
  </main>

  <script>
    function showSelectedFile(event) {
      const input = event.target;
      const fileBox = document.getElementById("selectedFileBox");
      const fileName = document.getElementById("selectedFileName");

      if (input.files && input.files.length > 0) {
        fileName.textContent = input.files[0].name;
        fileBox.classList.remove("hidden");
        fileBox.classList.add("flex");
      }
    }

    function clearSelectedFile() {
      const input = document.getElementById("image");
      const fileBox = document.getElementById("selectedFileBox");
      const fileName = document.getElementById("selectedFileName");

      input.value = "";
      fileName.textContent = "No file selected";
      fileBox.classList.add("hidden");
      fileBox.classList.remove("flex");
    }
  </script>
</body>
</html>