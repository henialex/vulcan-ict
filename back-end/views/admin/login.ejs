<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Vulcan ICT Admin Login</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
  />

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-tertiary-fixed": "#2c1700",
            "outline": "#6d7980",
            "surface-dim": "#d9dadb",
            "on-primary-fixed": "#001e2c",
            "surface-container-high": "#e7e8e9",
            "surface-container-lowest": "#ffffff",
            "tertiary-fixed": "#ffdcbc",
            "tertiary-container": "#f59a24",
            "inverse-surface": "#2e3132",
            "secondary-fixed-dim": "#a0cce7",
            "inverse-on-surface": "#f0f1f2",
            "surface-container": "#edeeef",
            "inverse-primary": "#78d1ff",
            "surface-container-highest": "#e1e3e4",
            "primary-container": "#06bcf9",
            "background": "#f8f9fa",
            "error": "#ba1a1a",
            "on-secondary-fixed-variant": "#1c4c62",
            "on-secondary-container": "#3a667d",
            "primary-fixed": "#c2e8ff",
            "on-surface": "#191c1d",
            "on-secondary": "#ffffff",
            "on-primary-fixed-variant": "#004d68",
            "on-primary": "#ffffff",
            "outline-variant": "#bcc8d1",
            "surface-bright": "#f8f9fa",
            "surface": "#f8f9fa",
            "error-container": "#ffdad6",
            "secondary": "#37637b",
            "primary": "#006689",
            "tertiary-fixed-dim": "#ffb86c",
            "on-background": "#191c1d",
            "on-surface-variant": "#3d484f",
            "surface-variant": "#e1e3e4",
            "surface-container-low": "#f3f4f5",
            "on-primary-container": "#004862",
            "on-error": "#ffffff",
            "on-secondary-fixed": "#001e2c",
            "primary-fixed-dim": "#78d1ff",
            "secondary-container": "#b6e3fe",
            "on-tertiary-fixed-variant": "#683c00",
            "surface-tint": "#006689",
            "on-tertiary-container": "#623800",
            "on-error-container": "#93000a",
            "secondary-fixed": "#c2e8ff",
            "tertiary": "#895100",
            "on-tertiary": "#ffffff"
          },
          borderRadius: {
            DEFAULT: "0.125rem",
            lg: "0.25rem",
            xl: "0.5rem",
            full: "0.75rem"
          },
          fontFamily: {
            headline: ["Manrope"],
            body: ["Inter"],
            label: ["Inter"]
          }
        }
      }
    };
  </script>

  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .bg-login-gradient {
      background: radial-gradient(circle at top right, #c2e8ff 0%, #f8f9fa 50%);
    }
  </style>
</head>

<body class="bg-background font-body text-on-surface antialiased min-h-screen flex items-center justify-center bg-login-gradient">
  <main class="w-full max-w-[440px] px-6">
    <div class="bg-surface-container-lowest rounded-xl p-8 md:p-10 transition-all duration-300">
      <div class="flex flex-col items-center mb-10">
        <div class="w-14 h-14 bg-gradient-to-br from-primary to-primary-container rounded-xl flex items-center justify-center mb-4 transform transition-transform hover:scale-105">
          <span class="material-symbols-outlined text-white text-3xl" style="font-variation-settings: 'FILL' 1;">shield_lock</span>
        </div>

        <h1 class="font-headline text-2xl font-extrabold tracking-tighter text-on-surface">
          Vulcan ICT
        </h1>
        <p class="font-label text-sm font-medium text-on-surface-variant mt-1">
          Admin Login
        </p>
      </div>

      <% if (error) { %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-6">
        <div class="space-y-2">
          <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant ml-1" for="email">
            Corporate Email
          </label>

          <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-outline text-lg transition-colors group-focus-within:text-primary">
                alternate_email
              </span>
            </div>

            <input
              class="block w-full pl-11 pr-4 py-3.5 bg-surface-container-low border-none rounded-xl text-on-surface placeholder:text-outline/50 focus:ring-0 focus:bg-surface-container-lowest transition-all duration-200"
              id="email"
              name="email"
              placeholder="admin@vulcanict.com"
              required
              type="email"
            />

            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary transition-all duration-300 group-focus-within:w-full"></div>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center px-1">
            <label class="font-label text-xs font-semibold uppercase tracking-wider text-on-surface-variant" for="password">
              Security Key
            </label>

            <span class="text-xs font-semibold text-outline cursor-default">
              Protected Access
            </span>
          </div>

          <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-outline text-lg transition-colors group-focus-within:text-primary">
                key
              </span>
            </div>

            <input
              class="block w-full pl-11 pr-4 py-3.5 bg-surface-container-low border-none rounded-xl text-on-surface placeholder:text-outline/50 focus:ring-0 focus:bg-surface-container-lowest transition-all duration-200"
              id="password"
              name="password"
              placeholder="••••••••••••"
              required
              type="password"
            />

            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary transition-all duration-300 group-focus-within:w-full"></div>
          </div>
        </div>

        <button
          class="w-full py-4 px-6 bg-gradient-to-r from-primary to-primary-container text-white font-headline font-bold text-base rounded-xl hover:shadow-[0_8px_20px_-4px_rgba(6,188,249,0.4)] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2"
          type="submit"
        >
          Authorize Access
          <span class="material-symbols-outlined text-xl">arrow_forward</span>
        </button>
      </form>

      <div class="mt-10 pt-6 border-t border-surface-container flex items-center justify-center gap-4">
        <div class="flex items-center gap-1.5 grayscale opacity-50">
          <span class="material-symbols-outlined text-base">encrypted</span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.1em]">AES-256 SECURED</span>
        </div>

        <div class="w-1 h-1 rounded-full bg-outline-variant"></div>

        <div class="flex items-center gap-1.5 grayscale opacity-50">
          <span class="material-symbols-outlined text-base">verified_user</span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.1em]">ISO 27001</span>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between px-2 gap-4">
      <div class="flex items-center gap-4">
        <span class="text-xs font-medium text-on-surface-variant">Internal Access</span>
        <span class="text-xs font-medium text-on-surface-variant">Authorized Personnel Only</span>
      </div>

      <p class="text-xs font-medium text-outline">© 2024 Vulcan ICT CMS</p>
    </div>
  </main>

  <div class="fixed bottom-0 right-0 p-12 opacity-5 pointer-events-none hidden lg:block">
    <span class="material-symbols-outlined text-[240px]">terminal</span>
  </div>
</body>
</html>