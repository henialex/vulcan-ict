<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <link rel="icon" type="image/png" href="/fav/favicon-32x32.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <title>ECTA / ECTMS National Traceability Success Story - Vulcan ICT PLC</title>

  <link rel="stylesheet" href="/css/bootstrap.css">
  <link rel="stylesheet" href="/vendors/linericon/style.css">
  <link rel="stylesheet" href="/css/font-awesome.min.css">
  <link rel="stylesheet" href="/vendors/owl-carousel/owl.carousel.min.css">
  <link rel="stylesheet" href="/vendors/lightbox/simpleLightbox.css">
  <link rel="stylesheet" href="/vendors/nice-select/css/nice-select.css">
  <link rel="stylesheet" href="/vendors/animate-css/animate.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>
  <%- include("partials/navbar") %>

  <section class="banner_area">
    <div class="banner_inner d-flex align-items-center">
      <div
        class="overlay bg-parallax"
        data-stellar-ratio="0.9"
        data-stellar-vertical-offset="0"
        data-background=""
      ></div>
      <div class="container">
        <div class="banner_content text-center">
          <h2>Success Story</h2>
          <div class="page_link">
            <a href="/">Home</a>
            <a href="/success-story-ecta">ECTA / ECTMS</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="p_120">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-7 mb-4 mb-lg-0">
          <span class="section_eyebrow">Government delivery • National platform</span>
          <h2 class="section_title_compact">
            ECTA / ECTMS: a national coffee traceability system built for compliance,
            adoption, and institutional ownership
          </h2>
          <p class="lead">
            Vulcan ICT designed and implemented a national geospatial database system
            and field-ready workflows to enable farm-to-export traceability and compliance
            readiness aligned with EUDR expectations.
          </p>

          <div class="story_chips">
            <span class="story_chip"><i class="fa fa-university"></i> Government system delivered</span>
            <span class="story_chip"><i class="fa fa-map"></i> National traceability</span>
            <span class="story_chip"><i class="fa fa-shield"></i> EUDR-aligned</span>
            <span class="story_chip"><i class="fa fa-exchange"></i> Handover completed</span>
            <span class="story_chip"><i class="fa fa-globe"></i> International presentation</span>
          </div>

          <div class="banner_btn_group mt-4">
            <a href="/contact" class="main_btn">Request a briefing</a>
            <a href="/insights" class="main_btn_secondary">View updates</a>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="project_card featured" style="margin: 0;">
            <div class="project_image">
              <img
                src="/img/case/ecta.jpg"
                alt="ECTA / ECTMS National Traceability System"
                class="project_case_image"
              >
            </div>
            <div class="project_content">
              <h4>Client</h4>
              <p class="project_type">
                <strong>Ethiopian Coffee and Tea Authority (ECTA)</strong>
              </p>
              <p class="project_description">
                National traceability and compliance platform supporting farm location
                management, verification workflows, and export readiness.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="p_120 bg-light">
    <div class="container">
      <div class="main_title text-center mb-5">
        <span class="section_eyebrow">Success story structure</span>
        <h2 class="section_title_compact">Problem → Solution → Impact</h2>
        <p>Clear outcomes, not generic descriptions.</p>
      </div>

      <div class="row">
        <div class="col-lg-4 mb-4">
          <div class="ps_card">
            <h4>Problem</h4>
            <p>
              National stakeholders needed audit-ready traceability and reliable
              farm-level data to support regulated market requirements, verification,
              and governance.
            </p>
          </div>
        </div>

        <div class="col-lg-4 mb-4">
          <div class="ps_card">
            <h4>Solution</h4>
            <p>
              Implemented a national platform combining GIS, mobile field workflows,
              centralized data governance, and compliance-ready reporting structures.
            </p>
          </div>
        </div>

        <div class="col-lg-4 mb-4">
          <div class="ps_card">
            <h4>Impact</h4>
            <p>
              Established a national traceability capability, enabled compliance
              readiness, supported international knowledge sharing, and completed
              institutional handover.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="p_120">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 mb-4">
          <div class="ps_card">
            <h4>Built for national rollout</h4>
            <p>
              Designed for real-world operation: governance roles, verification
              workflows, audit trails, and field-to-central data flows that support
              national adoption and continuity.
            </p>
          </div>
        </div>

        <div class="col-lg-6 mb-4">
          <div class="ps_card">
            <h4>EUDR-aligned compliance angle</h4>
            <p>
              Data structures and reporting workflows were designed to support due
              diligence expectations, traceability integrity, and compliance reporting
              requirements for regulated markets.
            </p>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-6 mb-4">
          <div class="ps_card">
            <h4>International exposure</h4>
            <p>
              ECTMS was presented internationally, demonstrating a scalable model for
              national traceability systems and sharing implementation learnings.
            </p>
          </div>
        </div>

        <div class="col-lg-6 mb-4">
          <div class="ps_card">
            <h4>Handover milestone (GIZ to ECTA)</h4>
            <p>
              Successful transition to institutional ownership, supported with
              documentation, training, and operational readiness for long-term continuity.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="p_120 bg-light">
    <div class="container">
      <div class="row align-items-start">
        <div class="col-lg-5 mb-4 mb-lg-0">
          <span class="section_eyebrow">Timeline</span>
          <h2 class="section_title_compact">Timeline / journey</h2>
          <p>
            Government-grade delivery is not just build-and-launch. It is design,
            rollout, adoption, and institutional ownership.
          </p>
        </div>

        <div class="col-lg-7">
          <div class="timeline">
            <div class="timeline_item">
              <div class="timeline_marker"></div>
              <div class="timeline_content">
                <h5>System design</h5>
                <p>Requirements, governance model, data structures, and traceability workflows.</p>
              </div>
            </div>

            <div class="timeline_item">
              <div class="timeline_marker"></div>
              <div class="timeline_content">
                <h5>Development</h5>
                <p>Platform implementation across GIS, field workflows, data validation, and reporting.</p>
              </div>
            </div>

            <div class="timeline_item">
              <div class="timeline_marker"></div>
              <div class="timeline_content">
                <h5>Deployment</h5>
                <p>Rollout enablement, training, and operational readiness support.</p>
              </div>
            </div>

            <div class="timeline_item">
              <div class="timeline_marker"></div>
              <div class="timeline_content">
                <h5>International presentation</h5>
                    <p>Knowledge sharing and external visibility (e.g., Zimbabwe).</p>
              </div>
            </div>

            <div class="timeline_item">
              <div class="timeline_marker"></div>
               <div class="timeline_content">
                 <h5>Handover</h5>
                    <p>Transition completed (GIZ → ECTA), enabling institutional ownership and continuity.</p>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="impress_area p_120 bg-primary text-white">
    <div class="container">
      <div class="impress_inner text-center">
        <h2>Planning a national traceability or compliance system?</h2>
        <p>
          Book a briefing. We will review governance needs, rollout realities,
          integrations, and compliance requirements.
        </p>
        <div class="cta_buttons">
          <a class="banner_btn2" href="/contact">Request a briefing</a>
          <a class="banner_btn2_light" href="/services">View capabilities</a>
        </div>
      </div>
    </div>
  </section>

  <%- include("partials/footer") %>

  <script src="/js/jquery-3.2.1.min.js"></script>
  <script src="/js/popper.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/stellar.js"></script>
  <script src="/vendors/lightbox/simpleLightbox.min.js"></script>
  <script src="/vendors/nice-select/js/jquery.nice-select.min.js"></script>
  <script src="/vendors/isotope/imagesloaded.pkgd.min.js"></script>
  <script src="/vendors/isotope/isotope-min.js"></script>
  <script src="/vendors/owl-carousel/owl.carousel.min.js"></script>
  <script src="/js/jquery.ajaxchimp.min.js"></script>
  <script src="/vendors/counter-up/jquery.waypoints.min.js"></script>
  <script src="/vendors/counter-up/jquery.counterup.min.js"></script>
  <script src="/js/mail-script.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>